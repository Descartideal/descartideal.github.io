---
import QuietLayout from '../../layouts/QuietLayout.astro';
import { getSortedPosts } from '../../utils/content-utils';
export async function getStaticPaths(){ const posts=await getSortedPosts(); return posts.map(entry=>({params:{slug:entry.slug},props:{entry}})); }
const {entry}=Astro.props;
const {Content, headings}=await entry.render();
---
<QuietLayout title={entry.data.title} description={entry.data.description || entry.data.title} article>
  <header class="article-head" data-pagefind-body>
    <a href="/" class="back">← 全部文章</a>
    <h1 data-pagefind-meta="title">{entry.data.title}</h1>
    <div class="article-meta"><time datetime={entry.data.published.toISOString()}>{new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Shanghai'}).format(entry.data.published)}</time><span>{entry.data.category}</span><span>{entry.data.tags.map((t: string)=>`#${t}`).join('　')}</span></div>
  </header>
  <div class="article-body">
    {headings.length>0 && <details class="toc" open><summary>文章目录</summary><ol>{headings.filter(h=>h.depth<=3).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>}
    <article class="prose" data-pagefind-body><Content /></article>
  </div>
  <div class="article-end"><a href="/archive/">← 文章归档</a></div>
</QuietLayout>
