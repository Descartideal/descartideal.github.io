---
import QuietLayout from '../layouts/QuietLayout.astro';
import { getSortedPosts } from '../utils/content-utils';
const posts = await getSortedPosts();
---
<QuietLayout>
  <section class="intro">
    <div class="eyebrow">THOUGHTS, ALGORITHMS & LIFE</div>
    <h1>笛卡尔似的梦<span style="color:var(--accent)">.</span></h1>
    <p class="subtitle">自由是遗忘的左伴随。</p>
  </section>
  <section aria-label="最新文章">
    <div class="section-label"><span>文字 / WRITINGS</span><span>共 {posts.length} 篇</span></div>
    {posts.map(post => <a class="post-row" href={`/posts/${post.slug}/`}>
      <time class="post-date" datetime={post.data.published.toISOString()}>{new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Shanghai'}).format(post.data.published).replaceAll('-',' / ')}</time>
      <div><h2>{post.data.title}</h2>{post.data.description && <p>{post.data.description}</p>}<div class="tags"><span>{post.data.category}</span>{post.data.tags.filter(t=>t!==post.data.category).map(t=><span>#{t}</span>)}</div></div>
      <span class="arrow" aria-hidden="true">↗</span>
    </a>)}
  </section>
</QuietLayout>
